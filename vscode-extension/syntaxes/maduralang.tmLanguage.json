{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MaduraLang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.mdr",
          "match": "//.*$"
        },
        {
          "name": "comment.block.mdr",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.maduralang",
          "match": "\\b(lamon enja'|lamon|laen|poter|sampek|ambu|terros|jhe_sossa|ngarte|ngamok|totop)\\b"
        },
        {
          "name": "keyword.declaration.maduralang",
          "match": "\\b(sango|paggun|lakona|pabali)\\b"
        },
        {
          "name": "keyword.operator.logical.maduralang",
          "match": "\\b(ban|otaba|benne)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.true.mdr",
          "match": "\\bbhender\\b"
        },
        {
          "name": "constant.language.boolean.false.mdr",
          "match": "\\bsala\\b"
        },
        {
          "name": "constant.language.null.mdr",
          "match": "\\b(tadhe'|tadhe|tadak)\\b"
        },
        {
          "name": "constant.language.undefined.mdr",
          "match": "\\bta_tao\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.mdr",
          "match": "\\b(kocaaghi|tanyaaghi)\\b"
        },
        {
          "name": "entity.name.function.mdr",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.mdr",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.mdr", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.single.mdr",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.mdr", "match": "\\\\." }]
        },
        {
          "name": "string.template.mdr",
          "begin": "`",
          "end": "`",
          "patterns": [{ "name": "constant.character.escape.mdr", "match": "\\\\." }]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.mdr",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.mdr",
          "match": "(\\+\\+|--|\\+=|-=|===|!==|==|!=|<=|>=|<|>|=|\\+|-|\\*|/|%|!)"
        }
      ]
    }
  },
  "scopeName": "source.mdr"
}
